<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="WL Orders"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.WLOrders">
        <!-- HTTPS only in release. Plain http:// (local test server) is allowed in
             debug builds only, via src/debug/AndroidManifest.xml. -->

        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HomeActivity"
            android:theme="@style/Theme.WLOrders.Home"
            android:exported="false" />

        <activity
            android:name=".OrdersActivity"
            android:theme="@style/Theme.WLOrders.Home"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <activity
            android:name=".OrderDetailActivity"
            android:theme="@style/Theme.WLOrders.Home"
            android:exported="false" />

    </application>

</manifest>
